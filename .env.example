# Ethiopian Power Monitor Environment Template (.env.example)
PORT=4000
HOST=0.0.0.0

# Database & Supabase PostGIS Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# EEU Official Telegram Ingestion Configuration
TELEGRAM_CHANNEL=eeuethiopia
TELEGRAM_CHANNELS=eeuethiopia
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# App Public URL
APP_URL=http://localhost:4000

# Gebeta Maps Geocoding API
GEBETA_MAPS_API_KEY=your_gebeta_maps_api_key

# Google Gemini API (Gemini 3.8 Flash Semantic & Multimodal Extraction)
GEMINI_API_KEY=your_gemini_api_key

